# 1. Locución ElevenLabs (narrador fijo ES: Carlos Aguilar 8MeTTgXVwMEhRVfblXOj). Imprescindible para voces reales.
ELEVENLABS_API_KEY=

# 2. Arte con IA (fondos y retratos de las personas reales). Con una alcanza; con las dos se pueden comparar.
#    Gemini = Nano Banana   ·   OpenAI = GPT Image
GEMINI_API_KEY=
OPENAI_API_KEY=
# Modelos (si no existen se prueban los de respaldo):
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image   (Nano Banana 2; gemini-3-pro-image = Nano Banana Pro)
# OPENAI_IMAGE_MODEL=gpt-image-2

# 3. Solo para el panel web automático (app/): quién estructura el guion si no lo hace el agente
ANTHROPIC_API_KEY=

# 4. Procesos en paralelo para el render 1080p (esta PC tiene 32 núcleos: 16 va bien)
RENDER_WORKERS=16
